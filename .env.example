# Public site URL (used for sitemap, canonical links, structured data)
NEXT_PUBLIC_SITE_URL=https://www.sritaraclassic.in

# Optional: where reservation requests are forwarded (e.g. a Make/Zapier/n8n
# webhook, or your own API). Leave empty to disable forwarding — the form will
# then ask guests to call instead. Keep this server-only (no NEXT_PUBLIC_).
RESERVATION_WEBHOOK_URL=
