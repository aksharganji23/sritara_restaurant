# Copy this file to .env.local (on your computer) and fill in the values.
# On Render: add the same keys under your service → Environment.

# ─── Required ───────────────────────────────────────────────────────────
# Neon Postgres connection string (Neon dashboard → Connect → copy).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Admin password for /admin — at least 10 characters. Changing it signs everyone out.
ADMIN_PASSWORD=

# Your public website address (used for Google search data and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.sritaraclassic.in

# ─── Optional ───────────────────────────────────────────────────────────
# Extra secret mixed into admin login cookies. Any long random text.
ADMIN_SESSION_SECRET=

# Booking alerts are normally set in Admin → Settings → Booking alerts.
# These are only used as a fallback if the admin fields are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Sends each booking as JSON to Make / n8n / Zapier / Google Apps Script.
RESERVATION_WEBHOOK_URL=
